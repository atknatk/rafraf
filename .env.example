# =============================================================================
# RafRaf - Dev Environment Variables
# =============================================================================
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=rafraf
POSTGRES_PASSWORD=rafraf_dev
POSTGRES_DB=rafraf
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rafraf:rafraf_dev@localhost:5432/rafraf

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT Authentication (T2.9: RS256 with HS256 grace period)
# -----------------------------------------------------------------------------
# RS256 (default — generate with: bash infra/scripts/generate-jwt-keys.sh)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# Legacy HS256 grace period — old tokens issued under HS256 are still
# accepted for verification until JWT_LEGACY_GRACE_UNTIL (UTC). After that
# timestamp, HS256 tokens are rejected and logged as
# "legacy_hs256_token_rejected_post_grace" for observability.
JWT_LEGACY_HS256_SECRET=
JWT_LEGACY_GRACE_UNTIL=2026-08-01T00:00:00Z

# DEPRECATED — kept for backward compat during the grace period; will be
# removed once all HS256 tokens have naturally expired. See
# docs/runbooks/jwt-key-rotation.md.
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Backend WebSocket (iOS client baglanti adresi)
# -----------------------------------------------------------------------------
BACKEND_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# APNs (iOS push notifications)
# -----------------------------------------------------------------------------
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.rafraf.app
APNS_USE_SANDBOX=true

# -----------------------------------------------------------------------------
# Claude Code (subscription default; ANTHROPIC_API_KEY opsiyonel fallback)
# -----------------------------------------------------------------------------
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_PROJECT_DIR=~/Code
CLAUDE_CODE_MODEL=opus
CLAUDE_CODE_TIMEOUT_SECONDS=300
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Fallback only — V1'de Claude Code subscription kullanir.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# GitHub API (PR tracking)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# AWS (S3 backups)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=rafraf-dev
AWS_REGION=eu-central-1
