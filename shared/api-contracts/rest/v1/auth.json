{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthEndpoints",
  "description": "JWT authentication endpoints - token olusturma ve yenileme",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/auth/token",
      "description": "Login ve JWT token olusturma",
      "requestBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Kullanici e-posta adresi"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Kullanici sifresi"
          }
        },
        "required": ["email", "password"],
        "additionalProperties": false
      },
      "responseBody": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token (15dk gecerli)"
          },
          "refresh_token": {
            "type": "string",
            "description": "JWT refresh token (7 gun gecerli)"
          },
          "token_type": {
            "type": "string",
            "enum": ["bearer"],
            "description": "Token tipi, her zaman bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Access token gecerlilik suresi (saniye)"
          }
        },
        "required": ["access_token", "refresh_token", "token_type", "expires_in"],
        "additionalProperties": false
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "description": "Refresh token ile yeni access ve refresh token olusturma",
      "requestBody": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "Mevcut refresh token"
          }
        },
        "required": ["refresh_token"],
        "additionalProperties": false
      },
      "responseBody": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Yeni JWT access token"
          },
          "refresh_token": {
            "type": "string",
            "description": "Yeni JWT refresh token (token rotation)"
          },
          "token_type": {
            "type": "string",
            "enum": ["bearer"],
            "description": "Token tipi, her zaman bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Access token gecerlilik suresi (saniye)"
          }
        },
        "required": ["access_token", "refresh_token", "token_type", "expires_in"],
        "additionalProperties": false
      }
    }
  ]
}
