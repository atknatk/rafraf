{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalMessages",
  "description": "WebSocket mesajlari: Approval sistemi soru-cevap akisi",
  "notes": [
    {
      "id": "timeout_seconds-bridge-clamp",
      "scope": "question.payload.timeout_seconds",
      "description": "V1.4-fix HIGH (commit 811ea0f) — when a bridge-originated event.session.permission_request envelope drives the question (see bridge-permission-messages.json), the question.timeout_seconds field reflects the bridge-suggested ceiling (typically 30s for the V1.4 PreToolUse hook flow), NOT the per-category default (180-300s in CATEGORY_TIMEOUTS, app/schemas/approval.py:110). ApprovalService.build_question_message clamps to record.bridge_timeout_seconds when present and falls back to the category default for orchestrator-originated approvals (kubectl, git_push, …). iOS RFApprovalSheet's countdown MUST mirror this value or the user watches the sheet collapse mid-tap. Cross-reference: docs/runbooks/permission-flow.md §13 latency budget."
    }
  ],
  "messages": [
    {
      "direction": "server_to_client",
      "type": "question",
      "description": "Kullaniciya onay sorusu gonder (tool calistirmadan once)",
      "payload": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string",
            "format": "uuid",
            "description": "Benzersiz onay talebi ID'si"
          },
          "question": {
            "type": "string",
            "description": "Kullaniciya gosterilecek soru metni"
          },
          "context": {
            "type": "string",
            "description": "Soruya ek bilgi/baglan (opsiyonel)"
          },
          "options": {
            "type": "array",
            "description": "Kullanicinin secebilecegi secenek listesi",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Secenek tanimlayicisi (approve/reject/detail)"
                },
                "label": {
                  "type": "string",
                  "description": "Kullaniciya gosterilen etiket"
                },
                "style": {
                  "type": "string",
                  "enum": ["primary", "danger", "secondary"],
                  "description": "Buton stili"
                }
              },
              "required": ["id", "label", "style"],
              "additionalProperties": false
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 600,
            "description": "Onay bekleme suresi (saniye)"
          },
          "category": {
            "type": "string",
            "enum": ["deploy", "destructive", "infrastructure", "write_remote"],
            "description": "Onay kategorisi"
          }
        },
        "required": ["approval_id", "question", "options", "timeout_seconds", "category"],
        "additionalProperties": false
      }
    },
    {
      "direction": "client_to_server",
      "type": "approval_response",
      "description": "Kullanici onay karari cevabi",
      "payload": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string",
            "format": "uuid",
            "description": "Cevaplanan onay talebi ID'si"
          },
          "decision": {
            "type": "string",
            "enum": ["approved", "rejected"],
            "description": "Kullanici karari"
          },
          "note": {
            "type": "string",
            "description": "Kullanici notu (opsiyonel)"
          }
        },
        "required": ["approval_id", "decision"],
        "additionalProperties": false
      }
    }
  ]
}
