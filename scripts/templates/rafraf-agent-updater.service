[Unit]
Description=RafRaf Host Agent Auto-Updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{SERVICE_USER}}
ExecStart=/bin/bash {{INSTALL_DIR}}/src/scripts/agent-updater.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rafraf-agent-updater
